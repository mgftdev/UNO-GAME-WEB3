{
  "compilerOptions": {
    "strict": true,
    "outDir": "./dist/",
    "sourceMap": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "jest",
      "node"
    ],
    "module": "ES2022"
  },
  "include": [
    "src/**/*.ts",
    "__test__/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
